# copy to backend/.env (never commit .env). every setting is optional; the
# defaults work for local dev. invalid values stop the server with a message
# (see src/config.ts).

PORT=4000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: debug in dev, info in prod)
LOG_LEVEL=debug
# comma separated origins allowed to call the api directly (full urls)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# requests per IP per 15 minutes on /api
RATE_LIMIT_MAX=300
# postgres connection string. needed for real data, e.g.
# postgresql://casestudy:casestudy@localhost:5432/casestudy (the docker-compose.yml database)
# DATABASE_URL=
# true = matching uses the short mock student list, false = postgres.
# unset: mock when there is no DATABASE_URL, postgres when there is.
# USE_MOCK_DATA=true
