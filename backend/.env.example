# copy to backend/.env (never commit .env). every setting is optional, the
# defaults work for local dev. invalid values stop the server with a message
# (see src/config.ts).

PORT=4000
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: debug in dev, info in prod)
LOG_LEVEL=debug
# comma separated origins allowed to call the api directly (full urls)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# requests per IP per 15 minutes on /api
RATE_LIMIT_MAX=300
# postgres connection string. needed for real data, e.g.
# postgresql://casestudy:casestudy@localhost:5432/casestudy (the docker-compose.yml database)
# DATABASE_URL=
# migrations need a direct (non-pooled) connection. for supabase use the
# session pooler string (port 5432). for local docker leave it out, npm run
# db:migrate uses DATABASE_URL.
# DIRECT_URL=
# true = matching uses the short mock student list, false = postgres.
# unset: mock when there is no DATABASE_URL, postgres when there is.
# USE_MOCK_DATA=true
# signs the session cookie, at least 32 characters. required in production, dev
# and tests use a built in one. make one with: openssl rand -hex 32
# SESSION_SECRET=
# the key the team operator sends to import a roster, at least 16 characters.
# left unset, roster import is off.
# OPERATOR_KEY=
# canvas rosters only have a login id (the case id), this is added to make the email
# SCHOOL_EMAIL_DOMAIN=case.edu
# the demo roster and the password free sign in (pick a student from a list). on
# by default except in production, where it can't be turned on. set false on any
# other server that real students use.
# DEMO_ROUTES=false
